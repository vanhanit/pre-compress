{
  "name": "@vanhanit/pre-compress",
  "version": "1.1.0",
  "description": "Compress static files to be served by a web server.",
  "author": "Thomas Vanhaniemi",
  "type": "module",
  "bin": {
    "pre-compress": "dist/main.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vanhanit/pre-compress.git"
  },
  "homepage": "https://github.com/vanhanit/pre-compress#readme",
  "bugs": {
    "url": "https://github.com/vanhanit/pre-compress/issues"
  },
  "license": "PolyForm-Shield-1.0.0",
  "keywords": [
    "compress",
    "compression",
    "precompress",
    "pre-compress",
    "glob",
    "br",
    "brotli",
    "gz",
    "gzip",
    "static",
    "assets"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  },
  "scripts": {
    "test": "node --test --test-reporter=spec \"tests/**/*.test.ts\"",
    "pretest:coverage": "node -e \"fs.mkdirSync('coverage', { recursive: true })\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info \"tests/**/*.test.ts\"",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "bench": "node bench/bench.ts",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test"
  }
}
