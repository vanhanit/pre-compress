{
  "name": "pre-compress",
  "version": "1.0.0",
  "description": "Compress static files to be served by a web server.",
  "author": "Thomas Vanhaniemi",
  "type": "module",
  "bin": "./bin/index.js",
  "engines": {
    "node": ">=22.18.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vanhanit/pre-compress.git"
  },
  "homepage": "https://github.com/vanhanit/pre-compress#readme",
  "bugs": {
    "url": "https://github.com/vanhanit/pre-compress/issues"
  },
  "license": "MIT",
  "keywords": [
    "compress",
    "compression",
    "precompress",
    "pre-compress",
    "glob",
    "br",
    "brotli",
    "gz",
    "gzip",
    "static",
    "assets"
  ],
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "fast-glob": "^3.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.15.17",
    "copyfiles": "^2.4.1",
    "cross-env": "^7.0.3",
    "eslint": "^10.12.0",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  },
  "scripts": {
    "test": "node --test --test-reporter=spec \"tests/**/*.test.ts\"",
    "pretest:coverage": "node -e \"fs.mkdirSync('coverage', { recursive: true })\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info \"tests/**/*.test.ts\"",
    "build": "rimraf dist && tsc -p tsconfig.build.json && copyfiles -f package.json dist/",
    "typecheck": "tsc",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test"
  }
}
